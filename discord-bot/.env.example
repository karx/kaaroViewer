# ── Discord application (Developer Portal) ─────────────────────────────────
# Bot tab → Reset Token. Three dot-separated segments, ~70 chars.
DISCORD_BOT_TOKEN=

# Application / General Information → Application ID.
DISCORD_CLIENT_ID=

# Optional: register the slash command to one guild only (near-instant
# propagation) instead of globally (can take up to an hour to show up).
DISCORD_GUILD_ID=

# ── GitHub ───────────────────────────────────────────────────────────────
# Personal access token with `repo` scope (classic) or Contents+Pull-requests
# write (fine-grained) on this repository. Used to open PRs via the REST API
# — the `gh` CLI is not required.
GITHUB_TOKEN=
GITHUB_OWNER=karx
GITHUB_REPO=kaaroViewer

# ── Agent backend ────────────────────────────────────────────────────────
# claude-code (default) | pi-coding-agent
AGENT_BACKEND=claude-code

# Only required when AGENT_BACKEND=pi-coding-agent. Passed to `pi --api-key`.
# (claude-code backend reuses this machine's existing `claude` CLI login —
# no separate key needed.)
PI_API_KEY=
PI_PROVIDER=anthropic
PI_MODEL=

# Milliseconds before a stuck encoder run is killed. Default 900000 (15 min).
# A run that untangles a bad source URL or a slow model can legitimately take
# most of that — see discord-bot/README.md's Observability section.
AGENT_TIMEOUT_MS=

# ── Paths ────────────────────────────────────────────────────────────────
# Absolute path to the kaaroViewer checkout this bot opens worktrees against.
# Defaults to the parent of this directory if unset.
KAARO_REPO_PATH=

# NEVER commit a filled-in .env. This file is gitignored — keep it that way.
