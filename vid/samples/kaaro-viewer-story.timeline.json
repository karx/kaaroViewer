            "params": {
              "index": 3,
              "count": 10,
              "title": "The Boundary Where Public Knowledge Ends",
              "narration": "Personal knowledge vaults, project notes, research documents — these texts have no QIDs. OpenTapioca cannot match them to Wikidata. SPARQL has nothing to retrieve. The open-world assumption fails at exactly the boundary where personal knowledge begins, and the system that works for public subjects cannot see private ones at all.",
              "tension": "medium",
              "accent": "#f05500",
              "docTitle": "kaaroViewer: A Self-Governing Spatial Intelligence Platform",
              "graph": {
                "nodes": [
