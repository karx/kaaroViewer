            "params": {
              "index": 4,
              "count": 10,
              "title": "LLM as Ontology Constructor",
              "narration": "An LLM is introduced to encode private text: identify entities, name types, trace relationships, construct narrative, surface insights. The intelligence brief format emerges — a seven-layer JSON document (meta, nodes, edges, story, insights, clusters, report_card) that becomes the system's lingua franca. The LLM can encode what NER cannot. The library grows beyond public knowledge into personal knowledge vaults.",
              "tension": "medium",
              "accent": "#e74c3c",
              "docTitle": "kaaroViewer: A Self-Governing Spatial Intelligence Platform",
              "graph": {
