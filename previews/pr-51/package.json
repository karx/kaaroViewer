{
  "name": "kaaro-viewer",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^25.0.0"
  },
  "vitest": {
    "environment": "jsdom",
    "include": ["**/*.test.mjs"],
    "exclude": ["node_modules", "pod_modules"]
  }
}
